# ── Ponto_Field — variáveis de ambiente ─────────────────────────────────────
# Copie para `.env` (não versionado) e ajuste. Em PRODUÇÃO defina TODAS abaixo.

# Ambiente: development | production
# Em production, segredos NÃO têm fallback inseguro — a app falha ao subir se faltarem.
APP_ENV=development

# Segredo de assinatura dos tokens de sessão (HMAC). OBRIGATÓRIO em produção.
# Gere um valor forte:  python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# Senha-mestra do gestor (bootstrap/recuperação). OBRIGATÓRIA em produção se não
# houver senha pessoal configurada. Em desenvolvimento, se vazia, usa "1989".
MASTER_ADMIN_PASSWORD=

# Validade do token de sessão, em segundos (padrão 12h).
AUTH_TTL_SECONDS=43200

# Origens permitidas no CORS (separadas por vírgula). Ajuste para o domínio do front.
CORS_ORIGINS=http://localhost:5173

# Banco e uploads.
DATABASE_URL=sqlite:///./che.db
UPLOAD_DIR=./uploads
