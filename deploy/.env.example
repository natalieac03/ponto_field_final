# ── Ponto_Field — variáveis de PRODUÇÃO ─────────────────────────────────────
# Copie para `.env` (não versionado) e preencha. NÃO comite o .env.

# Hostname público do sistema (aponte-o para o IP do servidor ANTES de subir).
#   DuckDNS (grátis)  → ex.: pontofieldtech.duckdns.org   ← recomendado para começar
#   domínio próprio   → ex.: ponto.fieldtechnology.com.br
#   :80               → só HTTP (teste / rede interna, sem HTTPS)
# NÃO use o DNS da AWS (ec2-...amazonaws.com): o Let's Encrypt recusa emitir cert p/ ele.
DOMAIN=pontofieldtech.duckdns.org

# E-mail para o registro do certificado TLS (Let's Encrypt) — recebe avisos de expiração.
TLS_EMAIL=ti@fieldtechnology.com.br

# Segredo de assinatura dos tokens de sessão (HMAC). OBRIGATÓRIO em produção.
# Gere:  python -c "import secrets;print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# Senha-mestra do gestor (bootstrap/recuperação). Defina uma FORTE — é o acesso
# admin inicial. Depois dá para trocar pela senha pessoal na tela de Configurações.
MASTER_ADMIN_PASSWORD=

# Validade do token de sessão em segundos (padrão 12h).
AUTH_TTL_SECONDS=43200

# CORS: com o proxy do Caddy o front e a API ficam no MESMO domínio (same-origin),
# então o CORS praticamente não é acionado. Mantenha a URL pública por segurança.
CORS_ORIGINS=https://pontofieldtech.duckdns.org

# NÃO defina DATABASE_URL / UPLOAD_DIR aqui: o container já aponta para /data
# (volume persistente). Sobrescrever pode gravar o banco fora do volume.

# (Opcional) Backup off-site: nome do bucket S3 para onde o backup.sh envia os
# arquivos de deploy/backups/. Deixe vazio para desativar. Ver DEPLOY.md (Passo 8.1).
S3_BUCKET=
