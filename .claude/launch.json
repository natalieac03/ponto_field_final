{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ponto-field-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "ponto-field-backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--reload", "--port", "8000", "--env-file", "backend/.env", "--app-dir", "backend"],
      "port": 8000
    }
  ]
}
